# Copy to backend/.env and fill in. Never commit .env.
# Loaded automatically on startup.
# ANALYZER: anthropic (default) | mock (offline, no API calls)
ANALYZER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Required only for organization-scoped keys
ANTHROPIC_WORKSPACE_ID=
# Optional: comma-separated origins allowed to call the API (default: the Vite dev server)
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Optional: where approved tasks are stored (default: backend/data/tasks.db)
# TASKS_DB=data/tasks.db
